# Persistent workspaces
WORKSPACE_ROOT=C:/path/to/persistent/workspaces

# Optional operation state/log directory. Defaults to .runtime/workspace-operations.
WORKSPACE_OPERATION_ROOT=C:/path/to/persistent/workspace-operations
WORKSPACE_PWSH_PATH=pwsh

# Quick commands can finish inside start; long commands return running + current logs.
WORKSPACE_COMMAND_SYNC_WAIT_SECONDS=5
WORKSPACE_COMMAND_TIMEOUT_SECONDS=120
WORKSPACE_COMMAND_MAX_TIMEOUT_SECONDS=3600
WORKSPACE_COMMAND_OUTPUT_BYTES=1000000
WORKSPACE_COMMAND_MAX_OUTPUT_BYTES=10000000

# Public Remote MCP URL. Subpaths are supported as long as the URL ends in /mcp.
MCP_PUBLIC_URL=https://mcp.example.com/mcp-app/mcp
MCP_HOST=127.0.0.1
MCP_PORT=8000

# OAuth is optional. Leave every OAUTH_* value unset for initial noauth testing.
# When OAuth is enabled later, set all three values below together.
# OAUTH_ISSUER=https://auth.example.com/
# OAUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json
# OAUTH_ALLOWED_SUBJECT=replace-with-your-subject
# OAUTH_ALLOWED_ALGORITHMS=RS256
# MCP_REQUIRED_SCOPE=workspace:execute
